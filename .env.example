NODE_ENV=production
AUTH_SECRET=replace-with-a-long-random-secret
PRESENTER_EMAIL=presenter@example.com
PRESENTER_PASSWORD=replace-with-a-strong-password
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=presenter@example.com
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_REDIRECT_URI=https://pinboard-live-production.up.railway.app/auth/google/callback
DATABASE_URL=postgresql://user:password@host:5432/database
MAX_QUESTION_MEDIA_BYTES=104857600
MAX_SESSION_MEDIA_BYTES=104857600
MAX_PLAYERS_PER_SESSION=250
MAX_SSE_CLIENTS_PER_SESSION=500
MAX_RATE_LIMIT_BUCKETS=5000
MAX_GOOGLE_UNKNOWN_KID_CACHE=1000
PERSISTED_SESSION_QUOTA_WINDOW_MS=21600000
RATE_LIMIT_PRUNE_INTERVAL_MS=60000
TRUST_PROXY=true
