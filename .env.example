NODE_ENV=development
PORT=4173
HOST=0.0.0.0
PUBLIC_ORIGIN=http://localhost:4173
TRUST_PROXY=false

# Replace every placeholder before using this configuration outside local development.
AUTH_SECRET=replace-with-at-least-32-random-characters
PRESENTER_EMAIL=presenter@example.com
PRESENTER_PASSWORD=replace-with-a-strong-password
ALLOW_INSECURE_LOCAL_AUTH=false

# Optional Google presenter sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/google/callback
GOOGLE_ALLOWED_EMAILS=presenter@example.com
GOOGLE_ALLOWED_DOMAINS=

# Leave blank to use the in-memory fallback locally. Configure PostgreSQL in production.
DATABASE_URL=

MAX_QUESTION_MEDIA_BYTES=104857600
MAX_MEDIA_STORAGE_BYTES_PER_PRESENTER=1073741824
MAX_MEDIA_ASSETS_PER_PRESENTER=500
MAX_PLAYERS_PER_SESSION=5000
